FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 400;

boundaryField
{
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    fluid_to_reacting
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        kappa           kappa;
        Tnbr            T;
        value           uniform 400;
    }
}


