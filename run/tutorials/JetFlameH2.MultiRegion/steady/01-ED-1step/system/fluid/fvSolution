FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(rho|rhoFinal)"
    {
        solver          PCG
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0;
    }

    p
    {
        solver           GAMG;
        tolerance        1e-7;
        relTol           0.01;
        smoother         GaussSeidel;
        maxIter          100;
    }
/*
    p
    {

        solver                GAMG;
        tolerance             1e-9;
        relTol                1e-6;
        smoother              GaussSeidel;
        cacheAgglomeration    true;
        nCellsInCoarsestLevel 20;
        agglomerator          faceAreaPair;
        mergeLevels           1;
    };
*/

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-9;
        relTol          1e-6;
	    minIter		    2;
    }



    "(e|h|k|epsilon)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          1e-6;
	    minIter		    2;
    }

    "Yi"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          1e-9;
	    minIter		    2;
    }

    G
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-08;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 	0;

    residualControl
    {
        p                   1e-9;
        U                   1e-9;
        "(k|epsilon|omega)" 1e-9;
    }
}

relaxationFactors
{
    fields
    {
        p               0.30;
        rho             0.01;
    }

    equations
    {
        // species
        default         0.2;

	    // fluid dynamics fields
        U               0.2;
        h               0.2;
	    e               0.2;
	    G		        0.2;

	    // turbulence fields
        k 		    0.2;
        epsilon 	0.2;
        omega 		0.2;
    }
}

