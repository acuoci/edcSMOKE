FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/reacting";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 290;

boundaryField
{
    inletfuel
    {
        type            fixedValue;
        value           uniform 294;
    }
    inletair
    {
        type            fixedValue;
        value           uniform 294;
    }
    outlet
    {
        type            zeroGradient;
    }
    axis
    {
        type            empty;
    }
    leftside
    {
        type            fixedValue;
        value           uniform 294;
    }
    burnerwall
    {
        type            zeroGradient;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    reacting_to_solid
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        kappa           kappa;
        Tnbr            T;
        value           uniform 290;
    }
    reacting_to_fluid
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        kappa           kappa;
        Tnbr            T;
        value           uniform 290;
    }
}


